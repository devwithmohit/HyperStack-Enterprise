# ── Server ────────────────────────────────────────────────────────────────────
PORT=3000
HOST=0.0.0.0
NODE_ENV=development

# ── Logging ───────────────────────────────────────────────────────────────────
LOG_LEVEL=info

# ── Database (PostgreSQL) ─────────────────────────────────────────────────────
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/hyperstack_dev
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=hyperstack_dev

# ── Cache (Redis) ─────────────────────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
